#!/usr/bin/env bash
# rp-governance-install - install governance kit into Retailpulses repos
set -euo pipefail

KIT_REPO="retailpulses/rp-governance-kit"
KIT_REF="main"
DRY_RUN=false
FORCE=false
WITH_SYNC_GOVERNANCE=false
REPOS_FILE=""
REPOS=()
INSTALLED=()
UPTODATE=()
FAILED=()
SKIPPED=()
PR_URLS=()
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

usage() {
  cat <<-USAGE
Usage:
  bin/rp-governance-install <owner/repo> [options]
  bin/rp-governance-install --repos repos.txt [options]

Options:
  --repos <file>            Batch mode: one owner/repo per line; blank lines and # comments ignored.
  --ref <ref>               Governance kit ref used by the workflow wrapper. Default: main.
  --dry-run                 Print planned changes without pushing branches or opening PRs.
  --force                   Overwrite repo-specific docs stubs except architecture SSOT.
  --with-sync-governance    Install sync workload governance and inventory template when absent.
  --help                    Show this help.
USAGE
}

die() { echo "Error: $*" >&2; exit 1; }

preflight() {
  command -v gh &>/dev/null || die "gh CLI not installed."
  gh auth status &>/dev/null || die "gh CLI not authenticated. Run 'gh auth login' first."
  for script in rp-issue-create rp-issue-audit rp-issue-work rp-issue-closeout rp-deploy-closeout rp-repo-housekeeping rp-worktree-hygiene; do
    [[ -f "$KIT_DIR/templates/bin/$script" ]] || die "Missing kit template: templates/bin/$script"
  done
  for doc in 00_CURRENT_STATE.md 01_ARCHITECTURE.md PHASE.template.md 05_DECISION_LOG.md 16_DATABASE_GOVERNANCE.md 17_SYNC_WORKLOAD_GOVERNANCE.md 18_WORKTREE_AND_SESSION_GOVERNANCE.md SYNC_JOB_INVENTORY.template.md; do
    [[ -f "$KIT_DIR/templates/docs/$doc" ]] || die "Missing kit template: templates/docs/$doc"
  done
  [[ -f "$KIT_DIR/templates/governance/local.yaml" ]] || die "Missing kit template: templates/governance/local.yaml"
}

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --help|-h) usage; exit 0 ;;
      --repos) [[ $# -ge 2 ]] || die "--repos requires a file"; REPOS_FILE="$2"; shift 2 ;;
      --ref) [[ $# -ge 2 ]] || die "--ref requires a value"; KIT_REF="$2"; shift 2 ;;
      --dry-run) DRY_RUN=true; shift ;;
      --force) FORCE=true; shift ;;
      --with-sync-governance) WITH_SYNC_GOVERNANCE=true; shift ;;
      -*) die "Unknown option: $1" ;;
      *) REPOS+=("$1"); shift ;;
    esac
  done
  if [[ -n "$REPOS_FILE" ]]; then
    [[ -f "$REPOS_FILE" ]] || die "Repos file not found: $REPOS_FILE"
    while IFS= read -r repo || [[ -n "$repo" ]]; do
      repo="${repo%%#*}"; repo="$(echo "$repo" | xargs)"; [[ -n "$repo" ]] && REPOS+=("$repo")
    done < "$REPOS_FILE"
  fi
  [[ ${#REPOS[@]} -gt 0 ]] || { usage; exit 1; }
}

repo_json_field() { gh repo view "$1" --json "$2" --jq ".$2" 2>/dev/null; }
default_branch() { gh repo view "$1" --json defaultBranchRef --jq '.defaultBranchRef.name' 2>/dev/null || echo main; }
is_archived() { [[ "$(repo_json_field "$1" isArchived)" == true ]]; }
find_existing_pr() { gh pr list --repo "$1" --head "$2" --state open --json url --jq '.[0].url // ""' 2>/dev/null; }

is_up_to_date() {
  local dir="$1" f
  local expected_files=(
    ".github/workflows/governance-checks.yml" ".github/workflows/database-governance.yml" ".github/pull_request_template.md"
    "bin/rp-issue-create" "bin/rp-issue-audit" "bin/rp-issue-work" "bin/rp-issue-closeout" "bin/rp-deploy-closeout" "bin/rp-repo-housekeeping" "bin/rp-worktree-hygiene"
    "docs/01_ARCHITECTURE.md" "docs/16_DATABASE_GOVERNANCE.md" "docs/18_WORKTREE_AND_SESSION_GOVERNANCE.md" "governance/local.yaml"
  )
  [[ "$WITH_SYNC_GOVERNANCE" == true ]] && expected_files+=("docs/17_SYNC_WORKLOAD_GOVERNANCE.md")
  for f in "${expected_files[@]}"; do [[ -f "$dir/$f" ]] || return 1; done
  grep -q "retailpulses/rp-governance-kit" "$dir/.github/workflows/governance-checks.yml" 2>/dev/null || return 1
  [[ "$(tr -d '\r\n' < "$dir/.github/governance-ref.txt" 2>/dev/null)" == "$KIT_REF" ]] || return 1
  grep -q "rp-issue-audit" "$dir/bin/rp-issue-work" 2>/dev/null || return 1
  grep -q "Canonical Architecture" "$dir/docs/01_ARCHITECTURE.md" 2>/dev/null || return 1
  grep -q "16_DATABASE_GOVERNANCE" "$dir/docs/16_DATABASE_GOVERNANCE.md" 2>/dev/null || return 1
  [[ "$WITH_SYNC_GOVERNANCE" != true ]] || grep -q "17_SYNC_WORKLOAD_GOVERNANCE" "$dir/docs/17_SYNC_WORKLOAD_GOVERNANCE.md" 2>/dev/null || return 1
  return 0
}

copy_files() {
  mkdir -p bin .github .github/workflows docs docs/phases governance
  local script doc installed_at
  for script in rp-issue-create rp-issue-audit rp-issue-work rp-issue-closeout rp-deploy-closeout rp-repo-housekeeping rp-worktree-hygiene; do
    cp "$KIT_DIR/templates/bin/$script" "bin/$script"; chmod +x "bin/$script"
  done
  cp "$KIT_DIR/templates/github/pull_request_template.md" .github/pull_request_template.md
  sed "s/__REF__/$KIT_REF/g" "$KIT_DIR/templates/github/workflows/governance-checks-wrapper.yml" > .github/workflows/governance-checks.yml
  if [[ -f "$KIT_DIR/templates/github/workflows/post-deploy-governance-wrapper.yml" ]]; then
    sed "s/__REF__/$KIT_REF/g" "$KIT_DIR/templates/github/workflows/post-deploy-governance-wrapper.yml" > .github/workflows/post-deploy-governance.yml 2>/dev/null || true
  fi
  sed "s/__REF__/$KIT_REF/g" "$KIT_DIR/templates/github/workflows/database-governance-wrapper.yml" > .github/workflows/database-governance.yml

  if [[ ! -f governance/local.yaml ]]; then
    sed "s/__GOVERNANCE_REF__/$KIT_REF/g" "$KIT_DIR/templates/governance/local.yaml" > governance/local.yaml
    echo "Minimal governance/local.yaml installed. Populate repository-specific declarations."
  fi

  installed_at=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
  for doc in 00_CURRENT_STATE.md 05_DECISION_LOG.md 10_ENGINEERING_PRINCIPLES.md 11_FRONTEND_STANDARDS.md 12_DATA_ACCESS_AND_SECRETS.md 13_PLATFORM_DEPENDENCY_POLICY.md 14_ISSUE_GOVERNANCE.md 15_DEPLOYMENT_AND_HOUSEKEEPING.md; do
    if [[ ! -f "docs/$doc" || "$FORCE" == true ]]; then cp "$KIT_DIR/templates/docs/$doc" "docs/$doc"; fi
  done

  # Architecture is repository-owned truth. Install only when absent; never overwrite it during upgrades, including --force.
  if [[ ! -f docs/01_ARCHITECTURE.md ]]; then
    cp "$KIT_DIR/templates/docs/01_ARCHITECTURE.md" docs/01_ARCHITECTURE.md
    echo "Architecture SSOT template installed. Reconcile it with actual implementation/deployment before architecture-affecting work."
  fi
  # Phase template is a starter artifact, not a managed active Phase.
  [[ -f docs/phases/README.template.md ]] || cp "$KIT_DIR/templates/docs/PHASE.template.md" docs/phases/README.template.md

  sed -e "s/__REF__/$KIT_REF/g" -e "s/__INSTALLED_AT__/$installed_at/g" "$KIT_DIR/templates/docs/16_DATABASE_GOVERNANCE.md" > docs/16_DATABASE_GOVERNANCE.md
  sed -e "s/__REF__/$KIT_REF/g" -e "s/__INSTALLED_AT__/$installed_at/g" "$KIT_DIR/templates/docs/18_WORKTREE_AND_SESSION_GOVERNANCE.md" > docs/18_WORKTREE_AND_SESSION_GOVERNANCE.md

  if [[ "$WITH_SYNC_GOVERNANCE" == true ]]; then
    sed -e "s/__REF__/$KIT_REF/g" -e "s/__INSTALLED_AT__/$installed_at/g" "$KIT_DIR/templates/docs/17_SYNC_WORKLOAD_GOVERNANCE.md" > docs/17_SYNC_WORKLOAD_GOVERNANCE.md
    if [[ ! -f docs/SYNC_JOB_INVENTORY.md ]]; then cp "$KIT_DIR/templates/docs/SYNC_JOB_INVENTORY.template.md" docs/SYNC_JOB_INVENTORY.md; else echo "Existing SYNC_JOB_INVENTORY.md found — not overwriting."; fi
  fi

  echo "$KIT_REF" > .github/governance-ref.txt
  touch .gitignore
  grep -q '^\.tmp/' .gitignore 2>/dev/null || printf '\n# Temp files\n.tmp/\n' >> .gitignore
}

has_changes() { ! git diff --quiet || ! git diff --cached --quiet || [[ -n "$(git ls-files --others --exclude-standard)" ]]; }

install_one() {
  local repo="$1" kit_commit branch tmpdir base existing_pr pr_url start_dir="$KIT_DIR"
  kit_commit=$(git -C "$KIT_DIR" rev-parse --short=12 HEAD) || die "Cannot resolve governance kit commit"
  branch="chore/install-governance-$kit_commit"
  echo ""; echo "========================================"; echo "Processing: $repo"; echo "========================================"
  if is_archived "$repo"; then echo "Skipping archived repo: $repo"; SKIPPED+=("$repo (archived)"); return; fi
  base=$(default_branch "$repo"); existing_pr=$(find_existing_pr "$repo" "$branch")
  cd /tmp; tmpdir=$(mktemp -d /tmp/rp-governance-XXXXXX)
  if ! gh repo clone "$repo" "$tmpdir" -- --quiet; then FAILED+=("$repo (clone failed)"); cd "$start_dir"; rm -rf "$tmpdir"; return; fi
  cd "$tmpdir"
  if [[ -n "$existing_pr" ]]; then git fetch origin "$branch" --quiet; git switch -c "$branch" "origin/$branch"; else git fetch origin "$base" --quiet; git switch -c "$branch" "origin/$base"; fi
  if is_up_to_date "$tmpdir"; then UPTODATE+=("$repo"); cd "$start_dir"; rm -rf "$tmpdir"; return; fi
  copy_files
  if ! has_changes; then UPTODATE+=("$repo"); cd "$start_dir"; rm -rf "$tmpdir"; return; fi
  git status --short
  if [[ "$DRY_RUN" == true ]]; then INSTALLED+=("$repo (dry-run)"); cd "$start_dir"; rm -rf "$tmpdir"; return; fi
  git add -A; git commit -m "chore: install governance kit" -m "Install centralized governance kit $KIT_REPO@$KIT_REF." >/dev/null; git push -u origin "$branch" --quiet
  if [[ -n "$existing_pr" ]]; then PR_URLS+=("$repo -> $existing_pr"); INSTALLED+=("$repo (updated PR)"); else
    pr_url=$(gh pr create --repo "$repo" --head "$branch" --base "$base" --title "chore: install governance kit" --body "Related to retailpulses/inbox#65

Installs/updates centralized Retailpulses governance, including the architecture SSOT starter when absent. Repository-owned architecture truth is never overwritten by upgrades. Review and reconcile docs/01_ARCHITECTURE.md before architecture-affecting work.")
    PR_URLS+=("$repo -> $pr_url"); INSTALLED+=("$repo")
  fi
  cd "$start_dir"; rm -rf "$tmpdir"
}

summary() {
  echo ""; echo "========================================"; echo Summary; echo "========================================"
  printf 'Installed/updated: %s\n' "${#INSTALLED[@]}"; printf 'Already up to date: %s\n' "${#UPTODATE[@]}"; printf 'Skipped: %s\n' "${#SKIPPED[@]}"; printf 'Failed: %s\n' "${#FAILED[@]}"
  if [[ ${#PR_URLS[@]} -gt 0 ]]; then printf '%s\n' "${PR_URLS[@]}"; fi
  [[ ${#FAILED[@]} -eq 0 ]]
}

main() { parse_args "$@"; preflight; local repo; for repo in "${REPOS[@]}"; do install_one "$repo"; done; summary; }
main "$@"
